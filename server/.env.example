# Local cascade (default production path)
STACKCHAN_PROVIDER=cascade
STACKCHAN_INTELLIGENCE_BACKEND=eve
STACKCHAN_EVE_URL=http://127.0.0.1:2000
STACKCHAN_EVE_MODEL=gpt-5.6-luna
# Write-capable Eve/MCP calls wait for one explicit bilingual voice decision.
# Silence expires to a durable denial; valid range is 5-300 seconds.
STACKCHAN_EVE_APPROVAL_TIMEOUT_SECONDS=30
STACKCHAN_SUPERTONIC_STEPS=5
# Confidence-gated Japanese route: base language ID -> small -> large fallback.
STACKCHAN_WHISPER_JA_CONFIDENCE_THRESHOLD=-0.18
# Replacement fragments are considered at this confidence only after a stable
# Stop/Wait cue has opened the one-shot ducked listening window.
STACKCHAN_BARGE_IN_CONTINUATION_CONFIDENCE_THRESHOLD=-0.70
# Keep ordinary speech at constant volume. Enable only for an explicit
# interruption experiment; semantic Stop/Wait cue ducking remains available.
STACKCHAN_BARGE_IN_ACOUSTIC_PREDUCK_ENABLED=false
# Coalesce the hold/swipe/touch burst emitted by one physical head pat.
STACKCHAN_HEAD_GESTURE_COOLDOWN_MS=2500

# Optional MaAI attentive listening. Install with `pixi install -e maai`.
# Shadow mode records predictions without moving the robot; validate it before
# setting false. Spoken backchannels are intentionally not injected over users.
STACKCHAN_MAAI_ENABLED=false
STACKCHAN_MAAI_SHADOW_MODE=true

# Bounded automatic memory. Profile extraction accepts only direct stable
# preferences/names; episodes expire and are capped. Set either flag false to
# retain explicit "remember this" memory only.
STACKCHAN_MEMORY_AUTOMATIC_PROFILES=true
STACKCHAN_MEMORY_EPISODIC_ENABLED=true
STACKCHAN_MEMORY_EPISODE_RETENTION_DAYS=30
STACKCHAN_MEMORY_EPISODE_LIMIT=50

# Native speech-to-speech alternative. Never commit a real key.
# STACKCHAN_PROVIDER=speech_to_speech
# OPENAI_API_KEY=replace-me
# STACKCHAN_OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# STACKCHAN_OPENAI_REALTIME_VOICE=marin
# STACKCHAN_OPENAI_REALTIME_REASONING_EFFORT=low
